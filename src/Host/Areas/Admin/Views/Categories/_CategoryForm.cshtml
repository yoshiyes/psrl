@model Passerelle.Host.ViewModels.CategoryFormViewModel

@{
    bool isEdit = Model.Id is not null && Model.Id != Guid.Empty;
    string formAction = isEdit
        ? $"/admin/categories/edit/{Model.Id}"
        : "/admin/categories/create";
}

<form method="post"
      action="@formAction"
      hx-post="@formAction"
      hx-target="#category-form-container"
      hx-swap="innerHTML"
      class="space-y-4 rounded-lg border border-gray-200 bg-white p-4 shadow-xs dark:border-gray-700 dark:bg-gray-800">
    @Html.AntiForgeryToken()

    <div>
        <label asp-for="Emoji" class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">
            @L["Admin_CategoryForm_Emoji"]
        </label>
        <input asp-for="Emoji"
               maxlength="32"
               placeholder="🏷️"
               class="w-24 rounded-lg border border-gray-200 px-3 py-2 text-sm leading-6 placeholder-gray-400 focus:border-orange-500 focus:ring-3 focus:ring-orange-500/50 dark:border-gray-700 dark:bg-gray-800 dark:focus:border-orange-500"
               value="@Model.Emoji"/>
        <span asp-validation-for="Emoji" class="text-sm text-red-600 dark:text-red-400"></span>
    </div>

    <div>
        <label asp-for="Name" class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">
            @L["Admin_CategoryForm_Name"]
        </label>
        <input asp-for="Name"
               class="w-full rounded-lg border border-gray-200 px-3 py-2 text-sm leading-6 placeholder-gray-400 focus:border-orange-500 focus:ring-3 focus:ring-orange-500/50 dark:border-gray-700 dark:bg-gray-800 dark:focus:border-orange-500"
               value="@Model.Name"/>
        <span asp-validation-for="Name" class="text-sm text-red-600 dark:text-red-400"></span>
    </div>

    <div class="flex justify-end gap-2">
        <button type="button"
                class="inline-flex items-center justify-center gap-2 rounded-lg border border-gray-200 bg-white px-4 py-2 text-sm leading-5 font-semibold text-gray-800 hover:border-gray-300 hover:shadow-xs focus:ring-3 focus:ring-gray-300/25 active:border-gray-200 active:shadow-none dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:border-gray-600 dark:hover:text-gray-200 dark:focus:ring-gray-600/40 dark:active:border-gray-700"
                hx-get="/admin/categories/cancel"
                hx-target="#category-form-container"
                hx-swap="innerHTML">
            @L["Admin_Common_Cancel"]
        </button>
        <button class="inline-flex items-center justify-center gap-2 rounded-lg border border-orange-700 bg-orange-700 px-4 py-2 text-sm leading-5 font-semibold text-white hover:border-orange-600 hover:bg-orange-600 focus:ring-3 focus:ring-orange-400/50 active:border-orange-700 active:bg-orange-700 dark:focus:ring-orange-400/90">
            @(isEdit ? L["Admin_CategoryForm_Edit"] : L["Admin_CategoryForm_Create"])
        </button>
    </div>
</form>