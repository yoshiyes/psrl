@{
    var message = ViewData["Message"] as string;
}

@if (!string.IsNullOrWhiteSpace(message))
{
    <div
        class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800 dark:border-amber-900/40 dark:bg-amber-900/20 dark:text-amber-400">
        @message
    </div>
}

<div
    class="rounded-lg border border-dashed border-gray-300 bg-gray-50 p-4 text-sm text-gray-500 dark:border-gray-600 dark:bg-gray-700/30 dark:text-gray-400">
    @L["Admin_Categories_SelectAction"]
</div>
