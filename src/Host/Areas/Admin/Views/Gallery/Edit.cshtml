@model Passerelle.Host.ViewModels.GalleryFormViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = L["Admin_GalleryForm_EditTitle"].Value;
}

@section PageActions {
    <div class="flex flex-none items-center justify-center gap-2 rounded-sm py-3 pl-2 sm:justify-end sm:bg-transparent">
        <a asp-area="Admin" asp-controller="Gallery" asp-action="Index"
           class="inline-flex items-center justify-center gap-2 rounded-lg border border-gray-600 bg-gray-700 px-3 py-2 text-sm leading-5 font-semibold text-gray-100 hover:border-gray-500 hover:bg-gray-600">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
                <path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd"/>
            </svg>
            <span>@L["Gallery_BackToGallery"]</span>
        </a>
    </div>
}

<div class="mx-auto max-w-3xl space-y-4">
    @if (Model.Id.HasValue)
    {
        <div class="flex items-center gap-4 rounded-lg border border-gray-200 bg-white p-4 shadow-xs dark:border-gray-700 dark:bg-gray-800">
            <a href="/gallery/@Model.Id" class="block h-16 w-24 shrink-0 overflow-hidden rounded-lg border border-gray-200 bg-gray-100 dark:border-gray-700 dark:bg-gray-900">
                <img src="/gallery/media/@Model.Id/thumb"
                     alt="@Model.Title"
                     class="h-full w-full object-cover"/>
            </a>
            <div class="min-w-0">
                <div class="truncate text-sm font-semibold text-gray-900 dark:text-gray-100">
                    @Model.Title
                </div>
                <a href="/gallery/@Model.Id"
                   class="mt-1 inline-flex items-center gap-1 text-xs font-medium text-orange-600 hover:text-orange-700 dark:text-orange-400">
                    <span>@L["Gallery_ViewDetails"]</span>
                </a>
            </div>
        </div>
    }

    <div id="gallery-form-container">
        @await Html.PartialAsync("_GalleryForm", Model)
    </div>
</div>
