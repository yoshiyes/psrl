@model Passerelle.Host.ViewModels.ImageTagsIndexViewModel

<div id="tags-table" class="grow p-5">
    @await Html.PartialAsync("_TagsTable", Model)
</div>

<div class="grow border-t border-gray-200 px-5 py-4 dark:border-gray-700">
    @await Html.PartialAsync("_Pagination", new Passerelle.Host.ViewModels.PaginationViewModel
    {
        Page = Model.Page,
        TotalCount = Model.TotalCount,
        TotalPages = Model.TotalPages,
        FormId = "tags-filters-form",
        SingularLabel = L["Pagination_Tags_Singular"].Value,
        PluralLabel = L["Pagination_Tags_Plural"].Value
    })
</div>
