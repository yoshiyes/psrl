@using Passerelle.Domain.Entities
@model Passerelle.Host.ViewModels.AdminIndexViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = L["Admin_Links_Title"].Value;
}

@section PageActions {
    <div class="flex flex-none items-center justify-center gap-2 rounded-sm py-3 pl-2 sm:justify-end sm:bg-transparent">
        <button
            class="inline-flex items-center justify-center gap-2 rounded-lg border border-orange-700 bg-orange-700 px-3 py-2 text-sm leading-5 font-semibold text-white hover:border-orange-600 hover:bg-orange-600 hover:text-white focus:ring-3 focus:ring-orange-400/90 active:border-orange-700 active:bg-orange-700"
            hx-get="/admin/links/create"
            hx-target="#link-form-container"
            hx-swap="innerHTML">
            <svg class="hi-mini hi-plus inline-block size-5 sm:opacity-50"
                 xmlns="http://www.w3.org/2000/svg"
                 viewBox="0 0 20 20"
                 fill="currentColor"
                 aria-hidden="true">
                <path
                    d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z"/>
            </svg>
            <span class="hidden sm:inline-block">@L["Admin_Links_New"]</span>
        </button>
    </div>
}


<div class="space-y-6">
    <div
        class="flex flex-col overflow-hidden rounded-lg bg-white shadow-xs dark:bg-gray-800 dark:text-gray-100 relative">
        <section class="overflow-hidden rounded-lg bg-white shadow-xs dark:bg-gray-800 dark:text-gray-100">
            <div class="space-y-3 px-5 py-4" id="link-form-container">
                @if (!string.IsNullOrWhiteSpace(Model.Message))
                {
                    <div
                        class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800 dark:border-amber-900/40 dark:bg-amber-900/20 dark:text-amber-400">
                        @Model.Message
                    </div>
                }

                <div class="rounded-lg border border-dashed border-gray-300 p-4 text-sm text-gray-500 dark:border-gray-600 dark:text-gray-400">
                    @L["Admin_Links_SelectAction"]
                </div>
            </div>
        </section>


        <div id="links-table-loader"
             class="table-loading-overlay htmx-indicator absolute inset-0 z-10 flex items-center justify-center bg-white/70 backdrop-blur-sm dark:bg-gray-900/70"
             aria-hidden="true">
            <svg class="size-8 animate-spin text-orange-500"
                 xmlns="http://www.w3.org/2000/svg"
                 fill="none"
                 viewBox="0 0 24 24"
                 stroke-width="1.5"
                 stroke="currentColor">
                <path stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.992 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"/>
            </svg>
        </div>

        <form
            id="admin-links-filters-form"
            class="flex flex-col gap-3 bg-gray-50 px-5 py-4 text-center sm:flex-row sm:items-center sm:justify-between sm:text-left dark:bg-gray-700/50"
            hx-get="@Url.Action("Index", "Links")"
            hx-target="#links-results"
            hx-swap="innerHTML"
            hx-indicator="#links-table-loader"
            hx-replace-url="true"
            hx-trigger="
        submit,
        change from:select[name='category'],
          input[target.value.length === 0 || target.value.length >= 3] changed delay:500ms from:input[name='q']">

            <!-- Search -->
            <div class="w-full sm:min-w-0 sm:flex-[1_1_50%]">
                <div class="relative">
                    <div
                        class="pointer-events-none absolute inset-y-0 left-0 my-px ml-px flex w-10 items-center justify-center rounded-l text-gray-500">
                        <svg
                            class="hi-mini hi-magnifying-glass inline-block size-5"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 20 20"
                            fill="currentColor"
                            aria-hidden="true">
                            <path
                                fill-rule="evenodd"
                                d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z"
                                clip-rule="evenodd"/>
                        </svg>
                    </div>
                    <input
                        type="text"
                        id="search"
                        value="@Model.Query"
                        name="q"
                        class="block w-full rounded-lg border border-gray-200 py-2 pr-10 pl-10 text-sm leading-6 placeholder-gray-400 focus:border-orange-500 focus:ring-3 focus:ring-orange-500/50 dark:border-gray-700 dark:bg-gray-800 dark:focus:border-orange-500"
                        placeholder="@L["Home_SearchPlaceholder"]"/>

                    <button
                        type="button"
                        id="clear-search"
                        class="absolute inset-y-0 right-0 my-px mr-px flex w-10 items-center justify-center rounded-r-lg text-gray-400 transition hover:text-gray-700 focus:outline-none focus:ring-3 focus:ring-orange-500/30 dark:text-gray-500 dark:hover:text-gray-200"
                        aria-label="@L["Search_Clear"]"
                        title="@L["Search_Clear"]">
                        <svg
                            class="size-5"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 20 20"
                            fill="currentColor"
                            aria-hidden="true">
                            <path
                                d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z"/>
                        </svg>
                    </button>
                </div>
            </div>
            <!-- Filter -->
            <div class="flex items-center gap-2">
                <select
                    name="category"
                    class="block w-full rounded-lg border border-gray-200 bg-white py-2 pr-10 pl-3 text-sm leading-5 font-semibold focus:border-orange-500 focus:ring-3 focus:ring-orange-500/50 sm:min-w-[220px] sm:w-auto dark:border-gray-700 dark:bg-gray-800 dark:focus:border-orange-500">
                    <option value="">@L["Admin_Links_FilterAllCategories"]</option>
                    @foreach (Category category in Model.Categories)
                    {
                        <option value="@category.Slug"
                                selected="@(Model.SelectedCategory == category.Slug)">@category.Name</option>
                    }
                </select>
            </div>

            <input type="hidden" id="page-input" name="page" value="@Model.Page"/>
            <input type="hidden" id="sort-input" name="sort" value="@Model.Sort"/>
        </form>

        <div id="links-results">
            @await Html.PartialAsync("_LinksResults", Model)
        </div>
    </div>
</div>


<style>
    .table-loading-overlay.htmx-indicator {
        opacity: 0;
        visibility: hidden;
        transition: opacity 200ms ease-in-out, visibility 200ms ease-in-out;
    }

    .htmx-request.table-loading-overlay,
    .htmx-request .table-loading-overlay {
        opacity: 1;
        visibility: visible;
    }
</style>

<script>
    const searchInput = document.getElementById("search");
    const clearSearchButton = document.getElementById("clear-search");

    if (searchInput && clearSearchButton) {
        const toggleClearSearchButton = () => {
            clearSearchButton.classList.toggle("hidden", searchInput.value.length === 0);
        };

        clearSearchButton.addEventListener("click", () => {
            searchInput.value = "";
            const sortInput = document.getElementById("sort-input");
            if (sortInput) {
                sortInput.value = "newest";
            }
            searchInput.focus();
            toggleClearSearchButton();

            searchInput.dispatchEvent(new Event("input", {
                bubbles: true
            }));
        });

        searchInput.addEventListener("input", toggleClearSearchButton);
        toggleClearSearchButton();
    }

    document.body.addEventListener("htmx:configRequest", function (event) {
        const form = document.getElementById("admin-links-filters-form");
        if (event.detail.elt !== form) {
            return;
        }

        const pageInput = document.getElementById("page-input");
        const sortInput = document.getElementById("sort-input");

        if (!pageInput || !sortInput) {
            return;
        }
        
        const triggeringEvent = event.detail.triggeringEvent;
        const submitter = triggeringEvent?.submitter;
        const target = triggeringEvent?.target;

        const isPaginationButton = submitter?.name === "page";
        const isSortButton = submitter?.name === "sort";
        const isCategoryFilter = target?.matches?.("select[name='category']");
        const isSearchInput = target?.matches?.("input[name='q']");

        if (isPaginationButton) {
            pageInput.value = submitter.value;
            return;
        }

        if (isSortButton) {
            sortInput.value = submitter.value;
        }

        if (isSearchInput) {
            const hasQuery = searchInput && searchInput.value.trim().length > 0;
            const newSort = hasQuery ? "relevance" : "newest";
            sortInput.value = newSort;
            event.detail.parameters.sort = newSort;
        }

        if (isSortButton || isCategoryFilter || isSearchInput) {
            pageInput.value = "1";
            event.detail.parameters.page = "1";
        }
    });
</script>
