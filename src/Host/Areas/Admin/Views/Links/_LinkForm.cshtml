@using Passerelle.Domain.Entities
@model Passerelle.Host.ViewModels.LinkFormViewModel

@{
    bool isEdit = Model.Id.HasValue;
    string postUrl = isEdit ? $"/admin/links/edit/{Model.Id}" : "/admin/links/create";
}

<div class="rounded-lg border border-gray-200 bg-white p-4 shadow-xs dark:border-gray-700 dark:bg-gray-800">
    <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-50">@(isEdit ? L["Admin_LinkForm_EditTitle"] : L["Admin_LinkForm_CreateTitle"])</h2>
    <form hx-post="@postUrl" hx-target="#link-form-container" hx-swap="innerHTML" class="mt-4 space-y-4">
        @Html.AntiForgeryToken()
        <div>
            <label asp-for="Title" class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"></label>
            <input asp-for="Title"
                   class="w-full rounded-lg border border-gray-200 px-3 py-2 text-sm placeholder-gray-400 focus:border-orange-500 focus:ring-3 focus:ring-orange-500/50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-100 dark:focus:border-orange-500"/>
            <span asp-validation-for="Title" class="text-sm text-rose-600 dark:text-rose-400"></span>
        </div>
        <div>
            <label asp-for="Url" class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"></label>
            <input asp-for="Url"
                   class="w-full rounded-lg border border-gray-200 px-3 py-2 text-sm placeholder-gray-400 focus:border-orange-500 focus:ring-3 focus:ring-orange-500/50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-100 dark:focus:border-orange-500"/>
            <span asp-validation-for="Url" class="text-sm text-rose-600 dark:text-rose-400"></span>
        </div>
        <div>
            <label asp-for="Description" class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300"></label>
            <textarea asp-for="Description" rows="4"
                      class="w-full rounded-lg border border-gray-200 px-3 py-2 text-sm placeholder-gray-400 focus:border-orange-500 focus:ring-3 focus:ring-orange-500/50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-100 dark:focus:border-orange-500"></textarea>
            <span asp-validation-for="Description" class="text-sm text-rose-600 dark:text-rose-400"></span>
        </div>
        <div>
            <span class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300">@L["Admin_LinkForm_Categories"]</span>
            <div class="grid gap-2 sm:grid-cols-2">
                @foreach (Category category in Model.AvailableCategories)
                {
                    <label class="flex items-center gap-2 rounded-lg border border-gray-200 px-3 py-2 text-sm text-gray-700 dark:border-gray-700 dark:text-gray-300">
                        <input type="checkbox" name="SelectedCategoryIds" value="@category.Id"
                               @(Model.SelectedCategoryIds.Contains(category.Id) ? "checked" : null)/>
                        <span>@category.Name</span>
                    </label>
                }
            </div>
            <span asp-validation-for="SelectedCategoryIds" class="text-sm text-rose-600 dark:text-rose-400"></span>
        </div>
        <button
            class="w-full rounded-lg border border-orange-700 bg-orange-700 px-4 py-2.5 font-medium text-white hover:border-orange-600 hover:bg-orange-600 focus:ring-3 focus:ring-orange-400/90 active:border-orange-700 active:bg-orange-700">
            @L["Admin_LinkForm_Save"]
        </button>
    </form>
</div>
