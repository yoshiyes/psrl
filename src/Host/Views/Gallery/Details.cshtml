@using System.Globalization
@using Passerelle.Domain.Entities
@model Passerelle.Domain.Entities.GalleryItem
@{
    string displayTitle = string.IsNullOrWhiteSpace(Model.Title) ? Model.OriginalFileName : Model.Title;
    ViewData["Title"] = displayTitle;
    bool isPhoto = Model.Type == GalleryItemType.Photo;
    List<ImageTag> tags = Model.GalleryItemTags.Select(x => x.ImageTag).ToList();
    bool showLocation = isPhoto &&
                        Model.LocationMode != GalleryLocationMode.Hidden &&
                        (!string.IsNullOrWhiteSpace(Model.LocationName) || (Model.Latitude.HasValue && Model.Longitude.HasValue));

    string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        double kb = bytes / 1024.0;
        if (kb < 1024) return $"{kb:0.#} KB";
        double mb = kb / 1024.0;
        return $"{mb:0.##} MB";
    }
}

@section PageActions {
    <div class="flex flex-none items-center justify-center gap-2 rounded-sm py-3 pl-2 sm:justify-end sm:bg-transparent">
        <a href="/gallery"
           class="inline-flex items-center justify-center gap-2 rounded-lg border border-gray-600 bg-gray-700 px-3 py-2 text-sm leading-5 font-semibold text-gray-100 hover:border-gray-500 hover:bg-gray-600">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
                <path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd"/>
            </svg>
            <span>@L["Gallery_BackToGallery"]</span>
        </a>
    </div>
}

<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    <!-- Left / Main Column: Optimized Preview Image & Description -->
    <div class="space-y-6 lg:col-span-2">
        <div class="overflow-hidden rounded-lg bg-white shadow-xs dark:bg-gray-800">
            <div class="flex items-center justify-center bg-gray-950 p-3 sm:p-6">
                <img src="/gallery/media/@Model.Id/preview"
                     alt="@(string.IsNullOrWhiteSpace(Model.Description) ? displayTitle : Model.Description)"
                     class="max-h-[75vh] w-auto max-w-full rounded object-contain"/>
            </div>

            <div class="space-y-4 p-5">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <div class="flex items-center gap-2">
                        @if (isPhoto)
                        {
                            <span class="inline-flex items-center gap-1 rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-800 dark:bg-amber-900/40 dark:text-amber-300">
                                <span aria-hidden="true">📷</span>
                                <span>@L["Gallery_Type_Photo"]</span>
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1 rounded-full bg-sky-100 px-3 py-1 text-xs font-semibold text-sky-800 dark:bg-sky-900/40 dark:text-sky-300">
                                <span aria-hidden="true">🎨</span>
                                <span>@L["Gallery_Type_Drawing"]</span>
                            </span>
                        }

                        <span class="text-xs text-gray-500 dark:text-gray-400">
                            @(Model.Width) × @(Model.Height) px • @FormatFileSize(Model.FileSizeBytes)
                        </span>
                    </div>

                    <a href="/gallery/media/@Model.Id/original"
                       class="inline-flex items-center gap-2 rounded-lg border border-gray-200 bg-white px-3.5 py-2 text-xs font-semibold text-gray-800 hover:border-gray-300 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
                            <path d="M10.75 2.75a.75.75 0 0 0-1.5 0v8.614L6.295 8.235a.75.75 0 1 0-1.09 1.03l4.25 4.5a.75.75 0 0 0 1.09 0l4.25-4.5a.75.75 0 0 0-1.09-1.03l-2.955 3.129V2.75Z"/>
                            <path d="M3.5 12.75a.75.75 0 0 0-1.5 0v2.5A2.75 2.75 0 0 0 4.75 18h10.5A2.75 2.75 0 0 0 18 15.25v-2.5a.75.75 0 0 0-1.5 0v2.5c0 .69-.56 1.25-1.25 1.25H4.75c-.69 0-1.25-.56-1.25-1.25v-2.5Z"/>
                        </svg>
                        <span>@L["Gallery_DownloadOriginal"] (@FormatFileSize(Model.FileSizeBytes))</span>
                    </a>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <div class="border-t border-gray-100 pt-4 dark:border-gray-700">
                        <h2 class="mb-1 text-xs font-semibold tracking-wider text-gray-400 uppercase dark:text-gray-500">
                            @L["Field_Description"]
                        </h2>
                        <p class="whitespace-pre-line text-sm leading-relaxed text-gray-700 dark:text-gray-200">@Model.Description</p>
                    </div>
                }

                @if (tags.Count > 0)
                {
                    <div class="border-t border-gray-100 pt-4 dark:border-gray-700">
                        <h2 class="mb-2 text-xs font-semibold tracking-wider text-gray-400 uppercase dark:text-gray-500">
                            @L["Gallery_Tags"]
                        </h2>
                        <div class="flex flex-wrap gap-2">
                            @foreach (ImageTag tag in tags)
                            {
                                <a href="/gallery?tag=@tag.Slug"
                                   class="inline-flex items-center gap-1.5 rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-800 hover:bg-emerald-200 dark:bg-emerald-900/40 dark:text-emerald-300 dark:hover:bg-emerald-900/60">
                                    @if (!string.IsNullOrWhiteSpace(tag.Emoji))
                                    {
                                        <span aria-hidden="true">@tag.Emoji</span>
                                    }
                                    <span>@tag.Name</span>
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right Column: Metadata, EXIF (if Photo) & Location -->
    <div class="space-y-6">
        @if (isPhoto)
        {
            <section class="overflow-hidden rounded-lg bg-white p-5 shadow-xs dark:bg-gray-800">
                <h2 class="flex items-center gap-2 text-base font-semibold text-gray-900 dark:text-gray-100">
                    <span aria-hidden="true">📷</span>
                    <span>@L["Gallery_Exif_Title"]</span>
                </h2>

                <dl class="mt-4 divide-y divide-gray-100 text-sm dark:divide-gray-700/60">
                    @if (!string.IsNullOrWhiteSpace(Model.CameraMake) || !string.IsNullOrWhiteSpace(Model.CameraModel))
                    {
                        <div class="flex justify-between py-2.5">
                            <dt class="text-gray-500 dark:text-gray-400">@L["Gallery_Exif_Camera"]</dt>
                            <dd class="font-medium text-right text-gray-900 dark:text-gray-100">
                                @($"{Model.CameraMake} {Model.CameraModel}".Trim())
                            </dd>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.LensModel))
                    {
                        <div class="flex justify-between py-2.5">
                            <dt class="text-gray-500 dark:text-gray-400">@L["Gallery_Exif_Lens"]</dt>
                            <dd class="font-medium text-right text-gray-900 dark:text-gray-100">@Model.LensModel</dd>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.FocalLength))
                    {
                        <div class="flex justify-between py-2.5">
                            <dt class="text-gray-500 dark:text-gray-400">@L["Gallery_Exif_FocalLength"]</dt>
                            <dd class="font-medium text-gray-900 dark:text-gray-100">@Model.FocalLength</dd>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Aperture))
                    {
                        <div class="flex justify-between py-2.5">
                            <dt class="text-gray-500 dark:text-gray-400">@L["Gallery_Exif_Aperture"]</dt>
                            <dd class="font-medium text-gray-900 dark:text-gray-100">@Model.Aperture</dd>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.ShutterSpeed))
                    {
                        <div class="flex justify-between py-2.5">
                            <dt class="text-gray-500 dark:text-gray-400">@L["Gallery_Exif_ShutterSpeed"]</dt>
                            <dd class="font-medium text-gray-900 dark:text-gray-100">@Model.ShutterSpeed</dd>
                        </div>
                    }
                    @if (Model.Iso.HasValue)
                    {
                        <div class="flex justify-between py-2.5">
                            <dt class="text-gray-500 dark:text-gray-400">@L["Gallery_Exif_Iso"]</dt>
                            <dd class="font-medium text-gray-900 dark:text-gray-100">ISO @Model.Iso</dd>
                        </div>
                    }
                    @if (Model.TakenAt.HasValue)
                    {
                        <div class="flex justify-between py-2.5">
                            <dt class="text-gray-500 dark:text-gray-400">@L["Gallery_Exif_TakenAt"]</dt>
                            <dd class="font-medium text-gray-900 dark:text-gray-100">
                                @Model.TakenAt.Value.ToDateTimeUtc().ToString("dd/MM/yyyy HH:mm")
                            </dd>
                        </div>
                    }

                    @if (string.IsNullOrWhiteSpace(Model.CameraMake) &&
                         string.IsNullOrWhiteSpace(Model.CameraModel) &&
                         string.IsNullOrWhiteSpace(Model.LensModel) &&
                         string.IsNullOrWhiteSpace(Model.FocalLength) &&
                         string.IsNullOrWhiteSpace(Model.Aperture) &&
                         string.IsNullOrWhiteSpace(Model.ShutterSpeed) &&
                         !Model.Iso.HasValue &&
                         !Model.TakenAt.HasValue)
                    {
                        <div class="py-3 text-xs text-gray-500 dark:text-gray-400">
                            @L["Gallery_Exif_None"]
                        </div>
                    }
                </dl>
            </section>
        }

        @if (showLocation)
        {
            <section class="overflow-hidden rounded-lg bg-white p-5 shadow-xs dark:bg-gray-800">
                <h2 class="flex items-center gap-2 text-base font-semibold text-gray-900 dark:text-gray-100">
                    <span aria-hidden="true">📍</span>
                    <span>@L["Gallery_Location_Title"]</span>
                </h2>

                <dl class="mt-4 divide-y divide-gray-100 text-sm dark:divide-gray-700/60">
                    @if (!string.IsNullOrWhiteSpace(Model.LocationName))
                    {
                        <div class="flex justify-between py-2.5">
                            <dt class="text-gray-500 dark:text-gray-400">@L["Gallery_Field_LocationName"]</dt>
                            <dd class="font-medium text-right text-gray-900 dark:text-gray-100">@Model.LocationName</dd>
                        </div>
                    }
                    @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                    {
                        string latStr = Model.Latitude.Value.ToString("0.######", CultureInfo.InvariantCulture);
                        string lonStr = Model.Longitude.Value.ToString("0.######", CultureInfo.InvariantCulture);
                        <div class="flex justify-between py-2.5">
                            <dt class="text-gray-500 dark:text-gray-400">@L["Gallery_Location_Coordinates"]</dt>
                            <dd class="font-mono text-xs font-medium text-gray-900 dark:text-gray-100">
                                @latStr, @lonStr
                            </dd>
                        </div>
                        <div class="pt-3">
                            <a href="https://www.openstreetmap.org/?mlat=@latStr&mlon=@lonStr#map=14/@latStr/@lonStr"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="inline-flex w-full items-center justify-center gap-1.5 rounded-lg border border-orange-200 bg-orange-50 px-3 py-2 text-xs font-semibold text-orange-700 hover:bg-orange-100 dark:border-orange-900/40 dark:bg-orange-900/20 dark:text-orange-300 dark:hover:bg-orange-900/40">
                                <span>@L["Gallery_Location_OpenMap"]</span>
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-3.5">
                                    <path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 0 0-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 0 0 .75-.75v-4a.75.75 0 0 1 1.5 0v4A2.25 2.25 0 0 1 12.75 17h-8.5A2.25 2.25 0 0 1 2 14.75v-8.5A2.25 2.25 0 0 1 4.25 4h5a.75.75 0 0 1 0 1.5h-5Z" clip-rule="evenodd"/>
                                    <path fill-rule="evenodd" d="M6.194 12.753a.75.75 0 0 0 1.06.053L16.5 4.44v2.81a.75.75 0 0 0 1.5 0v-4.5a.75.75 0 0 0-.75-.75h-4.5a.75.75 0 0 0 0 1.5h2.553l-9.056 8.194a.75.75 0 0 0-.053 1.06Z" clip-rule="evenodd"/>
                                </svg>
                            </a>
                        </div>
                    }
                </dl>
            </section>
        }

        <!-- General File Information -->
        <section class="overflow-hidden rounded-lg bg-white p-5 shadow-xs dark:bg-gray-800">
            <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100">
                @L["Gallery_Info_Title"]
            </h2>

            <dl class="mt-4 divide-y divide-gray-100 text-sm dark:divide-gray-700/60">
                <div class="flex justify-between py-2.5">
                    <dt class="text-gray-500 dark:text-gray-400">@L["Gallery_Info_Dimensions"]</dt>
                    <dd class="font-medium text-gray-900 dark:text-gray-100">@(Model.Width) × @(Model.Height) px</dd>
                </div>
                <div class="flex justify-between py-2.5">
                    <dt class="text-gray-500 dark:text-gray-400">@L["Gallery_Info_FileSize"]</dt>
                    <dd class="font-medium text-gray-900 dark:text-gray-100">@FormatFileSize(Model.FileSizeBytes)</dd>
                </div>
                <div class="flex justify-between py-2.5">
                    <dt class="text-gray-500 dark:text-gray-400">@L["Common_CreatedAt"]</dt>
                    <dd class="font-medium text-gray-900 dark:text-gray-100">
                        @Model.CreatedAt.ToDateTimeUtc().ToString("dd/MM/yyyy HH:mm")
                    </dd>
                </div>
            </dl>
        </section>
    </div>
</div>
