@using Passerelle.Domain.Entities
@model Passerelle.Host.ViewModels.GalleryIndexViewModel
@{
    ViewData["Title"] = L["Gallery_Title"].Value;
}

<div class="flex flex-col overflow-hidden rounded-lg bg-white shadow-xs dark:bg-gray-800 dark:text-gray-100 relative">
    <div id="gallery-loader"
         class="table-loading-overlay htmx-indicator absolute inset-0 z-10 flex items-center justify-center bg-white/70 backdrop-blur-sm dark:bg-gray-900/70"
         aria-hidden="true">
        <svg class="size-8 animate-spin text-orange-500"
             xmlns="http://www.w3.org/2000/svg"
             fill="none"
             viewBox="0 0 24 24"
             stroke-width="1.5"
             stroke="currentColor">
            <path stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.992 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"/>
        </svg>
    </div>

    <form
        id="gallery-filters-form"
        data-filters-form
        data-sort-on-search="true"
        hx-get="@Url.Action("Index", "Gallery")"
        hx-target="#gallery-results"
        hx-swap="innerHTML"
        hx-indicator="#gallery-loader"
        hx-replace-url="true"
        hx-trigger="
        submit,
        change from:input[name='type'],
        change from:input[name='tag'],
        input[target.value.length === 0 || target.value.length >= 3] changed delay:500ms from:input[name='q']">

        <div class="flex flex-col gap-3 bg-gray-50 px-5 py-4 sm:flex-row sm:items-center sm:justify-between dark:bg-gray-700/50">
            <!-- Search -->
            <div class="w-full sm:min-w-0 sm:flex-[1_1_50%]">
                <div class="relative">
                    <div
                        class="pointer-events-none absolute inset-y-0 left-0 my-px ml-px flex w-10 items-center justify-center rounded-l text-gray-500">
                        <svg
                            class="hi-mini hi-magnifying-glass inline-block size-5"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 20 20"
                            fill="currentColor"
                            aria-hidden="true">
                            <path
                                fill-rule="evenodd"
                                d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z"
                                clip-rule="evenodd"/>
                        </svg>
                    </div>
                    <input
                        type="text"
                        id="search"
                        value="@Model.Query"
                        name="q"
                        class="block w-full rounded-lg border border-gray-200 py-2 pr-10 pl-10 text-sm leading-6 placeholder-gray-400 focus:border-orange-500 focus:ring-3 focus:ring-orange-500/50 dark:border-gray-700 dark:bg-gray-800 dark:focus:border-orange-500"
                        placeholder="@L["Gallery_SearchPlaceholder"]"/>

                    <button
                        type="button"
                        id="clear-search"
                        data-clear-search
                        class="absolute inset-y-0 right-0 my-px mr-px flex w-10 items-center justify-center rounded-r-lg text-gray-400 transition hover:text-gray-700 focus:outline-none focus:ring-3 focus:ring-orange-500/30 dark:text-gray-500 dark:hover:text-gray-200"
                        aria-label="@L["Search_Clear"]"
                        title="@L["Search_Clear"]">
                        <svg
                            class="size-5"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 20 20"
                            fill="currentColor"
                            aria-hidden="true">
                            <path
                                d="M6.28 5.22a.75.75 0 00-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 101.06 1.06L10 11.06l3.72 3.72a.75.75 0 101.06-1.06L11.06 10l3.72-3.72a.75.75 0 00-1.06-1.06L10 8.94 6.28 5.22z"/>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Type Filter (All / Drawing / Photo) -->
            <div class="flex flex-wrap items-center justify-center gap-2 sm:justify-end">
                @{
                    string currentType = Model.SelectedType ?? "";
                    var typeOptions = new[]
                    {
                        new { Value = "", Label = L["Gallery_Filter_TypeAll"].Value, Icon = "🖼️" },
                        new { Value = "drawing", Label = L["Gallery_Type_Drawing"].Value, Icon = "🎨" },
                        new { Value = "photo", Label = L["Gallery_Type_Photo"].Value, Icon = "📷" }
                    };
                }
                @foreach (var opt in typeOptions)
                {
                    bool isSelected = currentType == opt.Value;
                    <label class="group relative flex">
                        <input type="radio"
                               class="peer absolute top-0 left-0 appearance-none opacity-0"
                               name="type"
                               value="@opt.Value"
                               checked="@isSelected"/>
                        <span
                            class="relative flex cursor-pointer items-center gap-1.5 rounded-lg border border-gray-200 bg-white px-3.5 py-2 text-sm font-medium group-hover:border-orange-500 peer-checked:border-orange-500 peer-checked:bg-orange-50 peer-checked:text-orange-700 peer-focus:ring-3 peer-focus:ring-orange-100 dark:border-gray-700 dark:bg-gray-800 dark:group-hover:border-orange-600 dark:peer-checked:border-orange-500 dark:peer-checked:bg-orange-900/20 dark:peer-checked:text-orange-300">
                            <span aria-hidden="true">@opt.Icon</span>
                            <span>@opt.Label</span>
                        </span>
                    </label>
                }
            </div>
        </div>

        <!-- Tags Filter -->
        @if (Model.Tags.Count > 0)
        {
            <div class="grow border-b border-slate-100 p-5 dark:border-slate-700">
                <div class="flex flex-wrap items-center gap-2">
                    @foreach (ImageTag tag in Model.Tags)
                    {
                        bool isChecked = Model.SelectedTags.Contains(tag.Slug);
                        <label class="group relative flex">
                            <input type="checkbox"
                                   class="peer absolute top-0 left-0 appearance-none opacity-0"
                                   name="tag"
                                   value="@tag.Slug"
                                   checked="@isChecked"/>
                            <span
                                class="relative flex grow cursor-pointer items-center gap-2 rounded-lg border border-gray-200 px-4 py-2 text-sm font-medium group-hover:border-orange-500 peer-checked:border-orange-400 peer-checked:bg-orange-50 peer-focus:ring-3 peer-focus:ring-orange-100 dark:border-gray-700 dark:group-hover:border-orange-600 dark:peer-checked:border-orange-600 dark:peer-checked:bg-orange-800/10 dark:peer-focus:ring-orange-900">
                                @if (!string.IsNullOrWhiteSpace(tag.Emoji))
                                {
                                    <span aria-hidden="true">@tag.Emoji</span>
                                }
                                @tag.Name
                            </span>
                        </label>
                    }
                </div>
            </div>
        }

        <input type="hidden" id="page-input" name="page" value="@Model.Page"/>
        <input type="hidden" id="sort-input" name="sort" value="@Model.Sort"/>
    </form>

    <div id="gallery-results">
        @await Html.PartialAsync("_GalleryResults", Model)
    </div>
</div>

<div id="gallery-preview-modal"></div>

<style>
    .table-loading-overlay.htmx-indicator {
        opacity: 0;
        visibility: hidden;
        transition: opacity 200ms ease-in-out, visibility 200ms ease-in-out;
    }

    .htmx-request.table-loading-overlay,
    .htmx-request .table-loading-overlay {
        opacity: 1;
        visibility: visible;
    }
</style>

@section Scripts {
    <script src="~/js/filters.js" asp-append-version="true"></script>
}
