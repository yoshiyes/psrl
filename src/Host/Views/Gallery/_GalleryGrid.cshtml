@using Passerelle.Domain.Entities
@model Passerelle.Host.ViewModels.GalleryIndexViewModel

@if (Model.Items.Count == 0)
{
    <div class="px-4 py-12 text-center text-sm text-stone-500 dark:text-gray-400">
        @L["Gallery_Empty"]
    </div>
}
else
{
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        @foreach (GalleryItem item in Model.Items)
        {
            List<ImageTag> tags = item.GalleryItemTags.Select(x => x.ImageTag).ToList();
            bool isPhoto = item.Type == GalleryItemType.Photo;

            <article class="group flex flex-col overflow-hidden rounded-xl border border-gray-200 bg-white shadow-xs transition hover:border-orange-400 hover:shadow-md dark:border-gray-700 dark:bg-gray-800/80 dark:hover:border-orange-500/70">
                <!-- Lightweight Thumbnail Trigger -->
                <button
                    type="button"
                    hx-get="/gallery/preview/@item.Id"
                    hx-target="#gallery-preview-modal"
                    hx-swap="innerHTML"
                    class="relative aspect-4/3 w-full cursor-pointer overflow-hidden bg-gray-100 text-left focus:outline-none dark:bg-gray-900"
                    title="@L["Gallery_PreviewAction"]">
                    <img
                        src="/gallery/media/@item.Id/thumb"
                        alt="@(string.IsNullOrWhiteSpace(item.Description) ? item.Title : item.Description)"
                        loading="lazy"
                        class="h-full w-full object-cover transition duration-300 group-hover:scale-105"/>

                    <div class="absolute top-2.5 left-2.5 flex items-center gap-1.5">
                        @if (isPhoto)
                        {
                            <span class="inline-flex items-center gap-1 rounded-full bg-gray-900/75 px-2.5 py-1 text-xs font-semibold text-amber-300 backdrop-blur-xs">
                                <span aria-hidden="true">📷</span>
                                <span>@L["Gallery_Type_Photo"]</span>
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-1 rounded-full bg-gray-900/75 px-2.5 py-1 text-xs font-semibold text-sky-300 backdrop-blur-xs">
                                <span aria-hidden="true">🎨</span>
                                <span>@L["Gallery_Type_Image"]</span>
                            </span>
                        }
                    </div>

                    <div class="absolute inset-0 flex items-center justify-center bg-black/0 opacity-0 transition group-hover:bg-black/25 group-hover:opacity-100">
                        <span class="inline-flex items-center gap-1.5 rounded-lg bg-gray-900/80 px-3 py-1.5 text-xs font-semibold text-white shadow-sm backdrop-blur-xs">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
                                <path d="M10 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"/>
                                <path fill-rule="evenodd" d="M.664 10.59a1.651 1.651 0 0 1 0-1.186A10.004 10.004 0 0 1 10 3c4.257 0 7.893 2.66 9.336 6.41.147.381.146.804 0 1.186A10.004 10.004 0 0 1 10 17c-4.257 0-7.893-2.66-9.336-6.41ZM14 10a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z" clip-rule="evenodd"/>
                            </svg>
                            <span>@L["Gallery_PreviewAction"]</span>
                        </span>
                    </div>
                </button>

                <!-- Card Body -->
                <div class="flex grow flex-col justify-between p-4">
                    <div class="space-y-2">
                        <div class="flex items-start justify-between gap-2">
                            <h3 class="line-clamp-1 font-semibold text-gray-900 dark:text-gray-100">
                                <a href="/gallery/@item.Id" class="hover:text-orange-600 dark:hover:text-orange-400">
                                    @(string.IsNullOrWhiteSpace(item.Title) ? item.OriginalFileName : item.Title)
                                </a>
                            </h3>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(item.Description))
                        {
                            <p class="line-clamp-2 text-xs text-gray-600 dark:text-gray-400">
                                @item.Description
                            </p>
                        }

                        @if (isPhoto && (!string.IsNullOrWhiteSpace(item.Aperture) || !string.IsNullOrWhiteSpace(item.ShutterSpeed) || item.Iso.HasValue))
                        {
                            <div class="flex flex-wrap items-center gap-1.5 pt-1 text-[11px] font-medium text-gray-500 dark:text-gray-400">
                                @if (!string.IsNullOrWhiteSpace(item.FocalLength))
                                {
                                    <span class="rounded bg-gray-100 px-1.5 py-0.5 dark:bg-gray-700/70">@item.FocalLength</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.Aperture))
                                {
                                    <span class="rounded bg-gray-100 px-1.5 py-0.5 dark:bg-gray-700/70">@item.Aperture</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.ShutterSpeed))
                                {
                                    <span class="rounded bg-gray-100 px-1.5 py-0.5 dark:bg-gray-700/70">@item.ShutterSpeed</span>
                                }
                                @if (item.Iso.HasValue)
                                {
                                    <span class="rounded bg-gray-100 px-1.5 py-0.5 dark:bg-gray-700/70">ISO @item.Iso</span>
                                }
                            </div>
                        }
                    </div>

                    <div class="mt-4 space-y-3 border-t border-gray-100 pt-3 dark:border-gray-700/60">
                        @if (tags.Count > 0)
                        {
                            <div class="flex flex-wrap items-center gap-1">
                                @foreach (ImageTag tag in tags.Take(3))
                                {
                                    <span class="inline-flex items-center gap-1 rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-semibold text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300">
                                        @if (!string.IsNullOrWhiteSpace(tag.Emoji))
                                        {
                                            <span aria-hidden="true">@tag.Emoji</span>
                                        }
                                        <span>@tag.Name</span>
                                    </span>
                                }
                                @if (tags.Count > 3)
                                {
                                    <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-semibold text-gray-600 dark:bg-gray-700 dark:text-gray-300">
                                        +@(tags.Count - 3)
                                    </span>
                                }
                            </div>
                        }

                        <div class="flex items-center justify-between text-xs text-gray-500 dark:text-gray-400">
                            <time datetime="@item.CreatedAt.ToDateTimeUtc().ToString("O")">
                                @item.CreatedAt.ToDateTimeUtc().ToString("dd/MM/yyyy")
                            </time>

                            <a href="/gallery/@item.Id"
                               class="inline-flex items-center gap-1 font-semibold text-orange-600 hover:text-orange-700 dark:text-orange-400 dark:hover:text-orange-300">
                                <span>@L["Gallery_ViewDetails"]</span>
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-3.5">
                                    <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/>
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            </article>
        }
    </div>
}
