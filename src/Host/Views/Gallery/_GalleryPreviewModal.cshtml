@using Passerelle.Domain.Entities
@model Passerelle.Domain.Entities.GalleryItem
@{
    bool isPhoto = Model.Type == GalleryItemType.Photo;
    List<ImageTag> tags = Model.GalleryItemTags.Select(x => x.ImageTag).ToList();
    bool showLocation = isPhoto && Model.LocationMode != GalleryLocationMode.Hidden &&
                        (!string.IsNullOrWhiteSpace(Model.LocationName) || (Model.Latitude.HasValue && Model.Longitude.HasValue));
}

<div id="gallery-modal-backdrop"
     class="fixed inset-0 z-50 flex items-center justify-center bg-black/75 p-4 backdrop-blur-xs"
     role="dialog"
     aria-modal="true"
     onclick="if (event.target === this) this.remove()">
    <div class="relative flex max-h-[90vh] w-full max-w-4xl flex-col overflow-hidden rounded-xl bg-white shadow-2xl dark:bg-gray-800 dark:text-gray-100">
        <!-- Modal Header -->
        <div class="flex items-center justify-between border-b border-gray-200 px-5 py-3.5 dark:border-gray-700">
            <div class="flex items-center gap-2.5 min-w-0">
                @if (isPhoto)
                {
                    <span class="inline-flex shrink-0 items-center gap-1 rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-800 dark:bg-amber-900/40 dark:text-amber-300">
                        <span aria-hidden="true">📷</span>
                        <span>@L["Gallery_Type_Photo"]</span>
                    </span>
                }
                else
                {
                    <span class="inline-flex shrink-0 items-center gap-1 rounded-full bg-sky-100 px-2.5 py-0.5 text-xs font-semibold text-sky-800 dark:bg-sky-900/40 dark:text-sky-300">
                        <span aria-hidden="true">🎨</span>
                        <span>@L["Gallery_Type_Image"]</span>
                    </span>
                }
                <h2 class="truncate text-base font-semibold text-gray-900 dark:text-gray-100">
                    @(string.IsNullOrWhiteSpace(Model.Title) ? Model.OriginalFileName : Model.Title)
                </h2>
            </div>

            <button type="button"
                    onclick="document.getElementById('gallery-modal-backdrop')?.remove()"
                    class="rounded-lg p-1.5 text-gray-400 hover:bg-gray-100 hover:text-gray-700 dark:hover:bg-gray-700 dark:hover:text-gray-200"
                    aria-label="@L["Gallery_Modal_Close"]">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5">
                    <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z"/>
                </svg>
            </button>
        </div>

        <!-- Lightweight WebP Preview Image -->
        <div class="flex min-h-0 flex-1 items-center justify-center overflow-auto bg-gray-950 p-2 sm:p-4">
            <img src="/gallery/media/@Model.Id/preview"
                 alt="@(string.IsNullOrWhiteSpace(Model.Description) ? Model.Title : Model.Description)"
                 class="max-h-[60vh] w-auto max-w-full rounded object-contain"/>
        </div>

        <!-- Modal Footer & Quick Info -->
        <div class="space-y-3 border-t border-gray-200 bg-gray-50 px-5 py-4 dark:border-gray-700 dark:bg-gray-800/90">
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="text-sm text-gray-700 dark:text-gray-300">@Model.Description</p>
            }

            <div class="flex flex-wrap items-center justify-between gap-3">
                <div class="flex flex-wrap items-center gap-2">
                    @if (isPhoto)
                    {
                        @if (!string.IsNullOrWhiteSpace(Model.CameraModel))
                        {
                            <span class="inline-flex items-center gap-1 rounded-md bg-gray-200/80 px-2 py-1 text-xs font-medium text-gray-700 dark:bg-gray-700 dark:text-gray-200">
                                📷 @Model.CameraModel
                            </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.FocalLength))
                        {
                            <span class="rounded-md bg-gray-200/80 px-2 py-1 text-xs font-medium text-gray-700 dark:bg-gray-700 dark:text-gray-200">
                                @Model.FocalLength
                            </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Aperture))
                        {
                            <span class="rounded-md bg-gray-200/80 px-2 py-1 text-xs font-medium text-gray-700 dark:bg-gray-700 dark:text-gray-200">
                                @Model.Aperture
                            </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.ShutterSpeed))
                        {
                            <span class="rounded-md bg-gray-200/80 px-2 py-1 text-xs font-medium text-gray-700 dark:bg-gray-700 dark:text-gray-200">
                                @Model.ShutterSpeed
                            </span>
                        }
                        @if (Model.Iso.HasValue)
                        {
                            <span class="rounded-md bg-gray-200/80 px-2 py-1 text-xs font-medium text-gray-700 dark:bg-gray-700 dark:text-gray-200">
                                ISO @Model.Iso
                            </span>
                        }
                    }

                    @if (showLocation)
                    {
                        <span class="inline-flex items-center gap-1 rounded-md bg-orange-100 px-2 py-1 text-xs font-medium text-orange-800 dark:bg-orange-900/30 dark:text-orange-300">
                            📍 @(!string.IsNullOrWhiteSpace(Model.LocationName)
                                ? Model.LocationName
                                : $"{Model.Latitude:0.####}, {Model.Longitude:0.####}")
                        </span>
                    }

                    @foreach (ImageTag tag in tags)
                    {
                        <span class="inline-flex items-center gap-1 rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-semibold text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300">
                            @if (!string.IsNullOrWhiteSpace(tag.Emoji))
                            {
                                <span aria-hidden="true">@tag.Emoji</span>
                            }
                            <span>@tag.Name</span>
                        </span>
                    }
                </div>

                <a href="/gallery/@Model.Id"
                   class="inline-flex shrink-0 items-center justify-center gap-2 rounded-lg border border-orange-700 bg-orange-700 px-4 py-2 text-sm font-semibold text-white hover:border-orange-600 hover:bg-orange-600 focus:ring-3 focus:ring-orange-400/50">
                    <span>@L["Gallery_ViewAllInfo"]</span>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
                        <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"/>
                    </svg>
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('keydown', function onEsc(e) {
        if (e.key === 'Escape') {
            document.getElementById('gallery-modal-backdrop')?.remove();
            document.removeEventListener('keydown', onEsc);
        }
    });
</script>
