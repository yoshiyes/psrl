<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" class="h-full">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Passerelle</title>
    <link rel="alternate" type="application/rss+xml" title="@L["Rss_Title"]" href="/feed.xml"/>

    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true"/>
</head>

<body class="antialiased dark:text-secondary-100 dark:bg-secondary-900 bg-white">
@RenderBody()

@await RenderSectionAsync("Scripts", false)
</body>
</html>