@{
    Layout = "_BaseLayout";
}

<div
    id="page-container"
    class="mx-auto flex min-h-dvh w-full min-w-80 flex-col bg-gray-100 dark:bg-gray-800/50 dark:text-gray-100">

    @await Html.PartialAsync("_Header")

    <!-- Page content -->
    <main id="page-content" class="flex max-w-full flex-auto flex-col">
        <!-- Page Heading -->
        <div class="h-48 bg-gray-800 text-gray-100">
            <div class="container mx-auto px-4 lg:px-8 xl:max-w-7xl">
                <div class="flex min-h-24 items-center border-t border-gray-700 py-4">
                    <div
                        class="grow">
                        <h1 class="text-2xl font-semibold">@(ViewData["Title"])</h1>
                    </div>
                    
                    @await RenderSectionAsync("PageActions", required: false)
                </div>
            </div>
        </div>

        <!-- Page Section -->
        <div class="container mx-auto -mt-28 p-4 lg:-mt-32 lg:p-8 xl:max-w-7xl">
            @RenderBody()
        </div>
    </main>

    @await Html.PartialAsync("_Footer")
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", false)
}

<script>
    (() => {
        const isDark =
            localStorage.theme === 'dark' ||
            (!('theme' in localStorage) &&
                window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', isDark);
    })();
</script>
