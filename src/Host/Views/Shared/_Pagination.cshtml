@model Passerelle.Host.ViewModels.PaginationViewModel

@{
    int currentPage = Model.Page <= 0 ? 1 : Model.Page;
    int totalPages = Model.TotalPages <= 0 ? 1 : Model.TotalPages;
    int totalCount = Math.Max(0, Model.TotalCount);

    int startPage = Math.Max(1, currentPage - 1);
    int endPage = Math.Min(totalPages, currentPage + 1);

    if (endPage - startPage < 2)
    {
        if (startPage == 1)
        {
            endPage = Math.Min(totalPages, startPage + 2);
        }
        else if (endPage == totalPages)
        {
            startPage = Math.Max(1, endPage - 2);
        }
    }

    string totalLabel = totalCount > 1 ? L["Pagination_Links_Plural"].Value : L["Pagination_Links_Singular"].Value;
}

<div class="text-center dark:text-gray-100">
    <div class="hidden sm:flex sm:items-center sm:justify-between">
        <div>
            @L["Pagination_Page"] <span class="font-semibold">@currentPage</span> @L["Pagination_Of"]
            <span class="font-semibold">@totalPages</span> (<span class="font-semibold">@totalCount</span> @totalLabel)
        </div>

        <nav class="inline-flex">
            @if (currentPage > 1)
            {
                <button
                    type="submit"
                    form="@Model.FormId"
                    name="page"
                    value="@(currentPage - 1)"
                    class="-mr-px inline-flex items-center justify-center gap-2 rounded-l-lg border border-gray-200 bg-white px-4 py-2 leading-6 font-semibold text-gray-800 hover:z-1 hover:border-gray-300 hover:text-gray-900 hover:shadow-xs focus:z-1 focus:ring-3 focus:ring-gray-300/25 active:z-1 active:border-gray-200 active:shadow-none dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:border-gray-600 dark:hover:text-gray-200 dark:focus:ring-gray-600/40 dark:active:border-gray-700"
                    aria-label="@L["Pagination_Previous"]">
                    <svg
                        class="hi-mini hi-chevron-left -mx-1.5 inline-block size-5"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                        aria-hidden="true">
                        <path
                            fill-rule="evenodd"
                            d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z"
                            clip-rule="evenodd"/>
                    </svg>
                </button>
            }
            else
            {
                <span
                    class="-mr-px inline-flex items-center justify-center gap-2 rounded-l-lg border border-gray-200 bg-gray-100 px-4 py-2 leading-6 font-semibold text-gray-400 dark:border-gray-700 dark:bg-gray-700/50 dark:text-gray-500">
                        <svg
                            class="hi-mini hi-chevron-left -mx-1.5 inline-block size-5"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 20 20"
                            fill="currentColor"
                            aria-hidden="true">
                            <path
                                fill-rule="evenodd"
                                d="M12.79 5.23a.75.75 0 01-.02 1.06L8.832 10l3.938 3.71a.75.75 0 11-1.04 1.08l-4.5-4.25a.75.75 0 010-1.08l4.5-4.25a.75.75 0 011.06.02z"
                                clip-rule="evenodd"/>
                        </svg>
                    </span>
            }

            @if (totalPages > 1 && startPage > 1)
            {
                <button
                    type="submit"
                    form="@Model.FormId"
                    name="page"
                    value="1"
                    class="-mr-px inline-flex items-center justify-center gap-2 border border-gray-200 bg-white px-4 py-2 leading-6 font-semibold text-gray-800 hover:z-1 hover:border-gray-300 hover:text-gray-900 hover:shadow-xs focus:z-1 focus:ring-3 focus:ring-gray-300/25 active:z-1 active:border-gray-200 active:shadow-none dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:border-gray-600 dark:hover:text-gray-200 dark:focus:ring-gray-600/40 dark:active:border-gray-700">
                    1
                </button>

                @if (startPage > 2)
                {
                    <div
                        class="-mr-px flex items-center justify-center border border-gray-200 bg-white px-4 text-gray-800 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300">
                        ...
                    </div>
                }
            }
            @if (totalPages == 1)
            {
                <span
                    class="-mr-px inline-flex items-center justify-center gap-2 border border-gray-200 bg-gray-100 px-4 py-2 leading-6 font-semibold text-gray-800 dark:border-gray-700 dark:bg-gray-700/75 dark:text-gray-300">
                        1
                    </span>
            }
            else
            {
                @for (int i = startPage; i <= endPage; i++)
                {
                    if (i == currentPage)
                    {
                        <span
                            class="-mr-px inline-flex items-center justify-center gap-2 border border-gray-200 bg-gray-100 px-4 py-2 leading-6 font-semibold text-gray-800 dark:border-gray-700 dark:bg-gray-700/75 dark:text-gray-300">
                                @i
                            </span>
                    }
                    else
                    {
                        <button
                            type="submit"
                            form="@Model.FormId"
                            name="page"
                            value="@i"
                            class="-mr-px inline-flex items-center justify-center gap-2 border border-gray-200 bg-white px-4 py-2 leading-6 font-semibold text-gray-800 hover:z-1 hover:border-gray-300 hover:text-gray-900 hover:shadow-xs focus:z-1 focus:ring-3 focus:ring-gray-300/25 active:z-1 active:border-gray-200 active:shadow-none dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:border-gray-600 dark:hover:text-gray-200 dark:focus:ring-gray-600/40 dark:active:border-gray-700">
                            @i
                        </button>
                    }
                }

                @if (endPage < totalPages)
                {
                    @if (endPage < totalPages - 1)
                    {
                        <div
                            class="-mr-px flex items-center justify-center border border-gray-200 bg-white px-4 text-gray-800 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300">
                            ...
                        </div>
                    }

                    <button
                        type="submit"
                        form="@Model.FormId"
                        name="page"
                        value="@totalPages"
                        class="-mr-px inline-flex items-center justify-center gap-2 border border-gray-200 bg-white px-4 py-2 leading-6 font-semibold text-gray-800 hover:z-1 hover:border-gray-300 hover:text-gray-900 hover:shadow-xs focus:z-1 focus:ring-3 focus:ring-gray-300/25 active:z-1 active:border-gray-200 active:shadow-none dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:border-gray-600 dark:hover:text-gray-200 dark:focus:ring-gray-600/40 dark:active:border-gray-700">
                        @totalPages
                    </button>
                }
            }

            @if (currentPage < totalPages)
            {
                <button
                    type="submit"
                    form="@Model.FormId"
                    name="page"
                    value="@(currentPage + 1)"
                    class="inline-flex items-center justify-center gap-2 rounded-r-lg border border-gray-200 bg-white px-4 py-2 leading-6 font-semibold text-gray-800 hover:z-1 hover:border-gray-300 hover:text-gray-900 hover:shadow-xs focus:z-1 focus:ring-3 focus:ring-gray-300/25 active:z-1 active:border-gray-200 active:shadow-none dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:border-gray-600 dark:hover:text-gray-200 dark:focus:ring-gray-600/40 dark:active:border-gray-700"
                    aria-label="@L["Pagination_Next"]">
                    <svg
                        class="hi-mini hi-chevron-right -mx-1.5 inline-block size-5"
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                        aria-hidden="true">
                        <path
                            fill-rule="evenodd"
                            d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z"
                            clip-rule="evenodd"/>
                    </svg>
                </button>
            }
            else
            {
                <span
                    class="inline-flex items-center justify-center gap-2 rounded-r-lg border border-gray-200 bg-gray-100 px-4 py-2 leading-6 font-semibold text-gray-400 dark:border-gray-700 dark:bg-gray-700/50 dark:text-gray-500">
                        <svg
                            class="hi-mini hi-chevron-right -mx-1.5 inline-block size-5"
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 20 20"
                            fill="currentColor"
                            aria-hidden="true">
                            <path
                                fill-rule="evenodd"
                                d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z"
                                clip-rule="evenodd"/>
                        </svg>
                    </span>
            }
        </nav>
    </div>
</div>