@model Passerelle.Host.ViewModels.SortButtonViewModel

@{
    var ascValue = $"{Model.SortKey}_asc";
    var descValue = $"{Model.SortKey}_desc";

    bool isAsc = Model.CurrentSort == ascValue;
    bool isDesc = Model.CurrentSort == descValue;
    bool isActive = isAsc || isDesc;

    string nextValue = isAsc ? descValue : ascValue;

    string buttonClasses = isActive
        ? "inline-flex items-center justify-center rounded-lg border border-orange-200 bg-orange-50 px-1.5 py-1 text-orange-600 transition hover:bg-orange-100 dark:border-orange-500/30 dark:bg-orange-500/10 dark:text-orange-400 dark:hover:bg-orange-500/20"
        : "inline-flex items-center justify-center rounded-lg border border-gray-200 px-1.5 py-1 text-gray-500 transition hover:border-gray-300 hover:text-gray-900 dark:border-gray-700 dark:text-gray-300 dark:hover:border-gray-600 dark:hover:text-gray-200";
}

<button
    type="submit"
    form="@Model.FormId"
    name="sort"
    value="@nextValue"
    class="@buttonClasses"
    aria-label="@L["Sort_By", Model.Label]">
    
    @if (isAsc)
    {
        <svg
            class="hi-mini hi-chevron-up inline-block size-4"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true">
            <path
                fill-rule="evenodd"
                d="M14.78 12.53a.75.75 0 01-1.06 0L10 8.81l-3.72 3.72a.75.75 0 11-1.06-1.06l4.25-4.25a.75.75 0 011.06 0l4.25 4.25a.75.75 0 010 1.06z"
                clip-rule="evenodd" />
        </svg>
    }
    else if (isDesc)
    {
        <svg
            class="hi-mini hi-chevron-down inline-block size-4"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true">
            <path
                fill-rule="evenodd"
                d="M5.22 7.47a.75.75 0 011.06 0L10 11.19l3.72-3.72a.75.75 0 111.06 1.06l-4.25 4.25a.75.75 0 01-1.06 0L5.22 8.53a.75.75 0 010-1.06z"
                clip-rule="evenodd" />
        </svg>
    }
    else
    {
        <svg
            class="hi-mini hi-chevron-up-down inline-block size-4"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            aria-hidden="true">
            <path
                fill-rule="evenodd"
                d="M10 3a.75.75 0 01.55.24l3.25 3.5a.75.75 0 11-1.1 1.02L10 4.852 7.3 7.76a.75.75 0 01-1.1-1.02l3.25-3.5A.75.75 0 0110 3zm-3.76 9.2a.75.75 0 011.06.04l2.7 2.908 2.7-2.908a.75.75 0 111.1 1.02l-3.25 3.5a.75.75 0 01-1.1 0l-3.25-3.5a.75.75 0 01.04-1.06z"
                clip-rule="evenodd" />
        </svg>
    }
</button>